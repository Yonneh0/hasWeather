// weather-local.js - Local sensor data override file
// =========================================
// Edit values below to inject local sensor readings into the weather display.
// Set any value to null to hide that sensor from the UI.
//
// The sensor bar appears directly below the header row, styled like city cards.
// Only sensors with non-null values are displayed.
//
// === CONFIGURATION ===

// Refresh interval in seconds (0 = disabled, no auto-refresh)
var LOCAL_CONFIG_REFRESH_INTERVAL_SECONDS = 30;

// Data expiry - ISO 8601 timestamp. When the current time exceeds this value,
// the entire sensor bar is hidden (stale data). Set to null to disable expiry.
var LOCAL_SENSOR_TTL = null;

// =========================================
// === INFO / META ===

// Displayed as a note across the top of the sensor bar
var LOCAL_SENSOR_NOTE = 'Local weather station - Charlotte area';

// Data source label (e.g., "Weather Station", "Arduino", "Raspberry Pi")
var LOCAL_SENSOR_DATA_SOURCE = 'Davis Vantage Pro2';

// Timestamp when the data was recorded (ISO 8601)
var LOCAL_SENSOR_TIMESTAMP = '2026-06-14T09:30:00.000Z';

// =========================================
// === TEMPERATURE SENSOR ===

// Current temperature - accepts a plain number (°F by default) or a string with unit:
//   "72.5" → 72.5°F
//   "22.5C" → 22.5°C
var LOCAL_SENSOR_TEMPERATURE = 72.5;

// "Feels like" temperature - accepts a plain number (°F by default) or a string with unit:
//   "68" → 68°F
//   "20C" → 20°C
var LOCAL_SENSOR_FEELSLIKE = null;

// Dew point - accepts a plain number (°F by default) or a string with unit:
//   "55" → 55°F
//   "13C" → 13°C
var LOCAL_SENSOR_DEWPOINT = null;

// =========================================
// === WIND SENSORS ===

// Wind speed - accepts a plain number (mph by default) or a string with unit:
//   "12" → 12 mph
//   "19km/h", "19kph", "19k" → 19 km/h
var LOCAL_SENSOR_WIND_SPEED = "11.2mph";

// Wind gust - accepts a plain number (mph by default) or a string with unit:
//   "18" → 18 mph
//   "29km/h", "29kph", "29k" → 29 km/h
var LOCAL_SENSOR_WIND_GUST = "18.4mph";

// Wind direction in degrees (0=N, 90=E, 180=S, 270=W)
var LOCAL_SENSOR_WIND_DIRECTION_DEGREES = 245;

// =========================================
// === HUMIDITY SENSOR ===

// Relative humidity as percentage (0-100)
var LOCAL_SENSOR_HUMIDITY_PERCENT = 67;

// =========================================
// === PRESSURE SENSOR ===

// Atmospheric pressure - accepts a plain number (inHg by default) or a string with unit:
//   "30.02" → 30.02 inHg
//   "1017hPa", "1017hpa" → 1017 hPa
var LOCAL_SENSOR_PRESSURE = 29.92;

// =========================================
// === GPS / LOCATION SENSORS ===

// Current latitude (-90 to 90)
var LOCAL_SENSOR_LATITUDE = 35.2271;

// Current longitude (-180 to 180)
var LOCAL_SENSOR_LONGITUDE = -80.8431;

// =========================================
// === ADDITIONAL SENSORS (optional) ===

// UV Index (0+)
var LOCAL_SENSOR_UV_INDEX = 4.2;

// Visibility - accepts a plain number (mi by default) or a string with unit:
//   "10" → 10 mi
//   "16km" → 16 km
var LOCAL_SENSOR_VISIBILITY = "10mi";

// Rainfall - accepts a plain number (inches by default) or a string with unit:
//   "0.15" → 0.15 in
//   "4mm" → 4 mm
var LOCAL_SENSOR_RAINFALL = "0.15in";

// Solar radiation in W/m² (useful for solar panel monitoring)
var LOCAL_SENSOR_SOLARRADIATION = 420;

// Soil moisture percentage (0-100, useful for garden/agriculture sensors)
var LOCAL_SENSOR_SOIL_MOISTURE_PERCENT = 62;